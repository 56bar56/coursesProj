# Copy this file to .env and fill in real values for local dev.

NODE_ENV=development
PORT=3001

# Matches docker-compose.yml postgres service. Host port is 5433, not 5432,
# because 5432 may already be taken by a native Postgres install on your machine.
DATABASE_URL="postgresql://courses:courses@localhost:5433/courses_dev?schema=public"

# Frontend origin, used for CORS and the OriginCheckGuard
FRONTEND_URL="http://localhost:5173"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Matches docker-compose.yml mailpit service
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="Courses Platform <no-reply@courses.local>"

# Seed script (npm run prisma:seed)
SEED_ADMIN_EMAIL="admin@courses.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_INSTRUCTOR_EMAIL="instructor@courses.local"
SEED_INSTRUCTOR_PASSWORD="ChangeMe123!"
SEED_MENTOR_EMAIL="mentor@courses.local"
SEED_MENTOR_PASSWORD="ChangeMe123!"

# Secret sign-up codes: entering one on the register page creates the account
# with that role instead of STUDENT. Leave a code unset (or empty) to disable
# self-service sign-up for that role. Share each code only with trusted people.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SIGNUP_CODE_INSTRUCTOR=""
SIGNUP_CODE_MENTOR=""
SIGNUP_CODE_ADMIN=""

# Local file storage stub for course video/resource content (no S3/R2 yet).
# Files are served through self-signed, expiring URLs (see src/storage).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STORAGE_SIGNING_SECRET="change-me-storage-secret"
LOCAL_STORAGE_DIR="./local-uploads"
SIGNED_URL_TTL_SECONDS=900

# Payments: no real Stripe account exists yet, so "fake" simulates the
# checkout+webhook lifecycle locally (see src/payments). Swapping to a real
# provider later only means implementing one more class against the same
# PaymentProvider interface.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYMENT_PROVIDER="fake"
PAYMENTS_FAKE_WEBHOOK_SECRET="change-me-payments-webhook-secret"

# AI quiz-mistake explainer. Works with any OpenAI-compatible chat API.
# Defaults target Groq's free tier: get a key at https://console.groq.com/keys
# Other free options: Gemini (AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai",
# AI_MODEL="gemini-2.0-flash") or local Ollama (AI_BASE_URL="http://localhost:11434/v1", no key).
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"
# Per-user cap on AI requests per minute, to stay inside free-tier limits.
AI_RATE_LIMIT_PER_MIN=10
