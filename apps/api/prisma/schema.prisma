generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  MENTOR
  ADMIN
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  locale       String   @default("en")
  roles        Role[]   @default([STUDENT])
  // Staff role requested via a secret sign-up code; granted on email verification.
  pendingRole  Role?
  emailVerified Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  coursesOwned        Course[]
  enrollments         Enrollment[]
  orders              Order[]
  attempts            Attempt[]
  mentorAvailability  MentorAvailability[]
  bookingsAsStudent   Booking[]            @relation("BookingStudent")
  bookingsAsMentor    Booking[]            @relation("BookingMentor")
  reviews             Review[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  RESOURCE
}

model Course {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String       @db.Text
  category    String
  language    String       @default("en")
  priceCents  Int          @default(0)
  currency    String       @default("USD")
  status      CourseStatus @default(DRAFT)

  ownerInstructorId         String
  ownerInstructor           User    @relation(fields: [ownerInstructorId], references: [id])
  instructorRevenueShareBps Int?
  rejectionReason           String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  orders      Order[]
  reviews     Review[]

  @@index([status, category])
  @@map("courses")
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id       String     @id @default(uuid())
  moduleId String
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type     LessonType
  title    String
  order    Int

  textContent String? @db.Text

  storageKey  String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  durationSec Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonProgress LessonProgress[]
  quiz           Quiz?

  @@index([moduleId, order])
  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchaseId  String?   @unique
  purchase    Order?    @relation(fields: [purchaseId], references: [id])
  progressPct Int       @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())

  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id              String     @id @default(uuid())
  enrollmentId    String
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean    @default(false)
  completedAt     DateTime?
  lastPositionSec Int?
  updatedAt       DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookingId   String?     @unique
  booking     Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String
  status      OrderStatus @default(PENDING)
  provider    String
  providerRef String?     @unique
  invoiceUrl  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  enrollment Enrollment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

enum QuestionType {
  MULTIPLE_CHOICE
  NUMERIC_ENTRY
}

model Quiz {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  timeLimitSec Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]

  @@map("quizzes")
}

model Question {
  id                   String       @id @default(uuid())
  quizId               String
  quiz                 Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order                Int
  text                 String       @db.Text
  type                 QuestionType
  options              String[]
  correctOptionIndex   Int?
  correctNumericAnswer String?
  explanation          String?      @db.Text

  answers AttemptAnswer[]

  @@index([quizId, order])
  @@map("questions")
}

model Attempt {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  scorePct    Int?
  isLate      Boolean   @default(false)

  answers AttemptAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
  @@map("attempts")
}

model AttemptAnswer {
  id                  String   @id @default(uuid())
  attemptId           String
  attempt             Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question             Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIndex Int?
  numericAnswer       String?
  isCorrect           Boolean?
  timeSpentSec        Int?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

enum SlotStatus {
  OPEN
  BOOKED
}

model MentorAvailability {
  id         String     @id @default(uuid())
  mentorId   String
  mentor     User       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  priceCents Int
  currency   String     @default("USD")
  status     SlotStatus @default(OPEN)
  createdAt  DateTime   @default(now())

  bookings Booking[]

  @@index([mentorId, startAt])
  @@index([status, startAt])
  @@map("mentor_availability")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

model Booking {
  id               String        @id @default(uuid())
  studentId        String
  student          User          @relation("BookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId         String
  mentor           User          @relation("BookingMentor", fields: [mentorId], references: [id])
  slotId           String
  slot             MentorAvailability @relation(fields: [slotId], references: [id])
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  amountCents      Int
  currency         String
  status           BookingStatus @default(PENDING_PAYMENT)
  videoJoinUrl     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Order?

  @@index([studentId])
  @@index([mentorId])
  @@index([slotId])
  @@map("bookings")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  text      String   @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, hidden])
  @@map("reviews")
}
